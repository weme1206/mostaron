# 统一换行符，避免 Windows / Linux 换行差异
* text=auto

# 明确文本文件
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jks binary
*.jar binary
